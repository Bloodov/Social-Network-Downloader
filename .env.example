# Токен от @BotFather. По умолчанию (если переменную не задать) используется
# значение, зашитое в config.py — но лучше задавать через переменную окружения,
# особенно если репозиторий публичный.
BOT_TOKEN=

# Telegram ID админов через запятую (узнать свой ID можно командой /myid у бота).
# По умолчанию используется значение, зашитое в config.py.
ADMIN_IDS=123456789

# Пауза между сообщениями при рассылке (сек) — защита от лимитов Telegram
BROADCAST_DELAY_SECONDS=0.05

# Логин/пароль веб-панели админа — ОБЯЗАТЕЛЬНО смени перед деплоем
ADMIN_USER=admin
ADMIN_PASS=change_me

# Антиспам
COOLDOWN_SECONDS=15
MAX_DOWNLOADS_PER_HOUR=10
MAX_CONCURRENT_DOWNLOADS=2
MAX_VIDEO_DURATION=1800

# Путь к файлу базы данных
DB_PATH=bot.db

# Railway подставит PORT автоматически, локально можно оставить так
PORT=8080
